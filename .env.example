# Supabase — Project Settings > API
# https://supabase.com/dashboard/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: legacy anon key (same value as publishable key on old projects)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: canonical site URL for share links and auth redirects.
# Defaults to https://$VERCEL_URL in production, http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
